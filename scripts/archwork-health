#!/usr/bin/env bash
#
# Assert that this machine is still the machine this repository describes.
#
# Installed to /usr/local/bin/archwork-health. Run it after an update, after a
# rollback, or whenever something feels wrong. M5's exit criteria name what it
# has to cover: subvolume mounts, encryption state, UKI presence, required
# services and the M4 timings.
#
# Self-contained on purpose, like archwork-rollback (D-014). A machine that
# needs checking may not have the repository on it, and a health check that
# cannot run on a broken machine is not a health check.
#
# It deliberately shares no code with tests/vm/lib/checks.sh, which asserts the
# same facts from the harness. That is not an oversight. The harness is the
# test and this is the thing being tested, and a test that imports the
# implementation of what it checks proves less than one that does not.

set -euo pipefail

PASSED=0
FAILED=0
SKIPPED=0
FAILURES=()

# Injectable so the unit tests can answer for a machine this one is not. On a
# real machine these are all the real thing.
FINDMNT="${FINDMNT:-findmnt}"
CRYPTSETUP="${CRYPTSETUP:-cryptsetup}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
EFI_ROOT="${EFI_ROOT:-/efi}"
HYPRIDLE_CONF="${HYPRIDLE_CONF:-}"
ROOT_DEVICE="${ROOT_DEVICE:-/dev/mapper/cryptroot}"
NVIDIA_MODULE_PATH="${NVIDIA_MODULE_PATH:-/sys/module/nvidia}"

usage() {
	cat <<'USAGE'
archwork-health [--quiet]

Checks that this machine still matches what the repository describes:
subvolume mounts and their boundaries, the encryption state, both Unified
Kernel Images, the services that have to be up, and the M4 idle timings.

  --quiet   print only failures and the summary

Exits non-zero if anything failed, so it can gate an update or a rollback.
USAGE
}

QUIET=false

pass() {
	PASSED=$((PASSED + 1))
	[ "$QUIET" = true ] || printf '  ok    %s\n' "$1"
}

fail() {
	FAILED=$((FAILED + 1))
	FAILURES+=("$1")
	printf '  FAIL  %s\n' "$1"
	[ -n "${2:-}" ] && printf '        %s\n' "$2"
	return 0
}

# Run a predicate and report it. Deliberately not `check cmd args`: an unknown
# command and a false answer look identical when output is discarded, which is
# a bug this project has already paid for twice.
check() {
	local description="$1"
	shift
	if ! declare -F "$1" >/dev/null 2>&1 && ! command -v "$1" >/dev/null 2>&1; then
		fail "$description" "no such check: $1"
		return 0
	fi
	if "$@"; then
		pass "$description"
	else
		fail "$description"
	fi
}

# Counted apart from the passes, and never silent. A check that does not apply
# to this machine has not been satisfied by it, and folding the two together is
# how a section that tests nothing comes to look green.
skip() {
	SKIPPED=$((SKIPPED + 1))
	[ "$QUIET" = true ] || printf '  skip  %s\n        %s\n' "$1" "$2"
}

heading() {
	[ "$QUIET" = true ] || printf '\n%s\n' "$1"
}

# --- storage -----------------------------------------------------------------

mounted_subvol() {
	"$FINDMNT" -no OPTIONS --target "$1" 2>/dev/null |
		tr ',' '\n' | sed -n 's/^subvol=//p' | head -1
}

subvol_mounted_at() {
	local want="$1" target="$2" actual
	actual="$(mounted_subvol "$target")"
	[ "$actual" = "$want" ] || [ "$actual" = "/$want" ]
}

mount_has_option() {
	"$FINDMNT" -no OPTIONS --target "$1" 2>/dev/null | tr ',' '\n' | grep -qx "$2"
}

# The constraint CLAUDE.md spells out and storage-boot.md does not: /var/lib
# holds the pacman database and must roll back with @. If it is on its own
# subvolume, a rollback leaves pacman describing packages that are not on disk.
var_lib_inside_root() {
	[ "$(mounted_subvol /var/lib)" = "$(mounted_subvol /)" ]
}

# --- encryption --------------------------------------------------------------

root_is_luks2() {
	"$CRYPTSETUP" status "$(basename "$ROOT_DEVICE")" 2>/dev/null |
		grep -qE 'type:[[:space:]]*LUKS2'
}

root_cipher_present() {
	"$CRYPTSETUP" status "$(basename "$ROOT_DEVICE")" 2>/dev/null |
		grep -qE 'cipher:[[:space:]]*\S'
}

# --- boot --------------------------------------------------------------------

uki_present() {
	[ -s "$EFI_ROOT/EFI/Linux/$1" ]
}

# --- services ----------------------------------------------------------------

service_active() {
	"$SYSTEMCTL" is-active --quiet "$1"
}

service_enabled() {
	local state
	state="$("$SYSTEMCTL" is-enabled "$1" 2>/dev/null)"
	[ "$state" = "enabled" ] || [ "$state" = "enabled-runtime" ] || [ "$state" = "static" ]
}

# --- NVIDIA sleep handling ---------------------------------------------------

# Whether the driver is on this machine at all, asked of the kernel rather than
# of a package database or a group variable. The health check is self-contained
# (D-014) and runs on machines that have neither.
nvidia_present() {
	[ -d "$NVIDIA_MODULE_PATH" ]
}

# Asked of the running module, not of /etc/modprobe.d. The file states an
# intent and the parameter states what the kernel actually loaded with, and
# between the two sits a reboot. Reading the file would report a machine as
# ready for a sleep it would still fail, which is the failure this check
# exists to catch.
nvidia_preserves_video_memory() {
	local value
	value="$(cat "$NVIDIA_MODULE_PATH/parameters/PreserveVideoMemoryAllocations" 2>/dev/null)" || return 1
	[ "$value" = "1" ] || [ "$value" = "Y" ]
}

# Preserving video memory into a tmpfs preserves it into RAM, which is the one
# place a suspend is about to stop refreshing. An unset parameter is the
# driver's own default of /tmp, and systemd makes that a tmpfs, so the default
# is the failing case and has to be read as one rather than skipped over.
nvidia_vram_path_is_real_storage() {
	local path fstype
	path="$(cat "$NVIDIA_MODULE_PATH/parameters/TemporaryFilePath" 2>/dev/null)" || return 1
	[ -n "$path" ] || path=/tmp
	fstype="$("$FINDMNT" -no FSTYPE --target "$path" 2>/dev/null)" || return 1
	[ -n "$fstype" ] || return 1
	[ "$fstype" != "tmpfs" ] && [ "$fstype" != "ramfs" ]
}

# --- the M4 timings ----------------------------------------------------------

# Read the file the daemon reads, not the one in a repository that may not be
# here. Same parse as the harness makes, written separately on purpose.
hypridle_conf_path() {
	if [ -n "$HYPRIDLE_CONF" ]; then
		printf '%s' "$HYPRIDLE_CONF"
		return 0
	fi
	local home
	for home in /home/*; do
		[ -f "$home/.config/hypr/hypridle.conf" ] || continue
		printf '%s' "$home/.config/hypr/hypridle.conf"
		return 0
	done
	return 1
}

listener_pairs_timeout_with() {
	local conf="$1" timeout="$2" needle="$3"
	awk -v want="$timeout" -v needle="$needle" '
		/^listener[[:space:]]*\{/ { t=""; found=0; next }
		/^\}/ { if (t == want && found) ok = 1; t=""; found=0; next }
		/^[[:space:]]*timeout[[:space:]]*=/ {
			value = $0
			gsub(/[^0-9]/, "", value)
			t = value
			next
		}
		index($0, needle) { found = 1 }
		END { exit ok ? 0 : 1 }
	' "$conf"
}

m4_timing() {
	local timeout="$1" needle="$2" conf
	conf="$(hypridle_conf_path)" || return 1
	listener_pairs_timeout_with "$conf" "$timeout" "$needle"
}

# --- the run -----------------------------------------------------------------

main() {
	while [ $# -gt 0 ]; do
		case "$1" in
		--quiet) QUIET=true; shift ;;
		-h | --help) usage; exit 0 ;;
		*) printf 'error: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
		esac
	done

	heading "Subvolume mounts (storage-boot.md)"
	check "/ is @" subvol_mounted_at @ /
	check "/home is @home" subvol_mounted_at @home /home
	check "/var/log is @var_log" subvol_mounted_at @var_log /var/log
	check "/var/cache is @var_cache" subvol_mounted_at @var_cache /var/cache
	check "/.snapshots is @snapshots" subvol_mounted_at @snapshots /.snapshots
	check "/ is mounted with zstd compression" mount_has_option / compress=zstd:3
	check "/var/lib rolls back with @, so pacman cannot outlive its packages" \
		var_lib_inside_root

	heading "Encryption (storage-boot.md, D-008)"
	check "the root device is LUKS2" root_is_luks2
	check "the root device reports a cipher" root_cipher_present

	heading "Unified Kernel Images (D-011, D-014)"
	check "the primary UKI is present and not empty" uki_present archwork.efi
	check "the recovery UKI is present and not empty" uki_present archwork-recovery.efi

	heading "Services (D-002, D-004, D-019)"
	check "greetd is enabled" service_enabled greetd.service
	check "greetd is running" service_active greetd.service
	check "NetworkManager is running" service_active NetworkManager.service
	check "tailscaled is enabled" service_enabled tailscaled.service
	check "tailscaled is running" service_active tailscaled.service

	heading "NVIDIA sleep handling (D-043)"
	if nvidia_present; then
		# All three, because the gate is the driver being present and not
		# which profile this is. A machine that never hibernates still wants
		# the unit that would save its VRAM if it did.
		check "nvidia-suspend is enabled" service_enabled nvidia-suspend.service
		check "nvidia-hibernate is enabled" service_enabled nvidia-hibernate.service
		check "nvidia-resume is enabled" service_enabled nvidia-resume.service
		check "the driver is told to preserve video memory across a sleep" \
			nvidia_preserves_video_memory
		check "the preserved video memory lands on storage, not in RAM" \
			nvidia_vram_path_is_real_storage
	else
		skip "the NVIDIA sleep units" "no NVIDIA driver on this machine"
	fi

	heading "Idle and sleep timings (security-power.md, D-028)"
	check "the display dims at 300s" m4_timing 300 brightnessctl
	check "the display switches off at 900s" m4_timing 900 'action = "off"'
	check "the machine sleeps at 1800s" m4_timing 1800 'systemctl suspend'

	printf '\n'
	local skipped=""
	[ "$SKIPPED" -gt 0 ] && skipped="$(printf ', %d skipped' "$SKIPPED")"
	if [ "$FAILED" -gt 0 ]; then
		printf '%d passed, %d FAILED%s\n' "$PASSED" "$FAILED" "$skipped"
		local failure
		for failure in "${FAILURES[@]}"; do
			printf '  - %s\n' "$failure"
		done
		return 1
	fi

	printf '%d passed, nothing failed%s\n' "$PASSED" "$skipped"
	return 0
}

# Sourced by tests/unit/archwork-health.bats to reach the predicates above
# without running a health check against the machine running the tests.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	main "$@"
fi
